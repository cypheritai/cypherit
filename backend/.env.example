# CypherIt Backend Environment Variables
# Copy this file to .env and fill in your values

# ===================
# REQUIRED
# ===================

# Anthropic API Key (for Claude extraction)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===================
# OPTIONAL
# ===================

# ScraperAPI Key (fallback proxy for YouTube transcripts)
# Only needed if direct transcript fetching fails
# Get yours at: https://www.scraperapi.com/
SCRAPER_API_KEY=

# Alternative: Full proxy URL
# PROXY_URL=http://scraperapi:YOUR_KEY@proxy-server.scraperapi.com:8001
